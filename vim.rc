#include <winver.h>
#include "version.h"

// Application icon (Explorer also shows it for vim.exe).
1 ICON "vim.ico"

// Embedded process manifest. 24 is RT_MANIFEST. The UIAccess build
// (make uiaccess, windres -DUIACCESS) embeds vim.uiaccess.manifest instead.
#ifdef UIACCESS
1 24 "vim.uiaccess.manifest"
#else
1 24 "vim.manifest"
#endif

1 VERSIONINFO
FILEVERSION     VIM_VERSION_MAJOR, VIM_VERSION_MINOR, VIM_VERSION_PATCH, 0
PRODUCTVERSION  VIM_VERSION_MAJOR, VIM_VERSION_MINOR, VIM_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "vim mouse - keyboard mouse control"
            VALUE "FileVersion",      VIM_VERSION_RC_STR
            VALUE "InternalName",     "vim"
            VALUE "OriginalFilename", "vim.exe"
            VALUE "ProductName",      "vim mouse"
            VALUE "ProductVersion",   VIM_VERSION_RC_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
